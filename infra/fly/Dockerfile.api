FROM python:3.12-slim-bookworm AS base
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# Build deps + WeasyPrint native libs (Pango/Cairo/GdkPixbuf) + Postgres client.
# These are heavy (~200MB) — accepted trade-off for in-app PDF rendering.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libpq5 \
        libpango-1.0-0 \
        libpangoft2-1.0-0 \
        libharfbuzz0b \
        libcairo2 \
        libgdk-pixbuf-2.0-0 \
        libffi8 \
        fonts-inter \
        fonts-noto-core \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# uv for fast dep install
COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /uvx /usr/local/bin/

WORKDIR /app

# Dependency layer (cached on lockfile-only changes)
COPY apps/api/pyproject.toml apps/api/uv.lock* ./
RUN uv sync --frozen --no-install-project

# App layer
COPY apps/api/ ./
RUN uv sync --frozen

ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 8000

# Run migrations on startup, then serve. Honors $PORT (set by Render/Fly/etc),
# defaulting to 8000 for local Docker runs.
CMD ["sh", "-c", "alembic upgrade head && uvicorn job_os.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"]
