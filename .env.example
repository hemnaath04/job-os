# --- Database ---
# Neon: https://console.neon.tech — enable pgvector extension
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DB?ssl=true
# Keep these small on autoscaling/serverless hosts such as Vercel. The
# defaults remain 5/10 for a single long-running Render or Fly instance.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3

# --- Redis (Celery broker + cache) ---
# Upstash: https://console.upstash.com (use the rediss:// connection string)
REDIS_URL=rediss://default:PASSWORD@HOST:6379

# --- Auth (Clerk) ---
# https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# --- LLM providers ---
# Personal Anthropic-compatible gateway (Zavora). The base URL + key both go here;
# all LLM calls route through this single endpoint.
# Set the ORIGIN only, with no /v1: the Anthropic SDK appends /v1/messages itself,
# so a trailing /v1 requests /v1/v1/messages and every call 404s. Settings strips
# a trailing /v1 defensively, since gateway docs usually include it.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://app.manifest.build

# Model overrides — routed through Manifest, so use `manifest/auto` and let the
# gateway pick the real model. Override with a specific model only if you have a
# reason to pin one for a given call site.
ANTHROPIC_MODEL_EXTRACT=manifest/auto
ANTHROPIC_MODEL_TAILOR=manifest/auto
ANTHROPIC_MODEL_VERIFY=manifest/auto
# Manifest custom routes configured in the gateway dashboard.
MANIFEST_TIER_FAST=job-os-fast
MANIFEST_TIER_QUALITY=job-os-quality

# Note: this project uses Claude only — no OpenAI/embeddings provider.

# --- Scraping ---
FIRECRAWL_API_KEY=fc-...
# Optional (used for harder ATS targets):
APIFY_API_TOKEN=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# --- Job discovery ---
# TheirStack key (used by the discovery MCP — see ~/.claude memory)
THEIRSTACK_API_KEY=
# Optional. Raises GitHub README verification rate limits on Render/Vercel.
GITHUB_TOKEN=

# --- Blob storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=job-os-artifacts
R2_PUBLIC_BASE_URL=

# --- Reactive Resume (self-hosted instance for PDF/DOCX rendering) ---
REACTIVE_RESUME_BASE_URL=
REACTIVE_RESUME_API_KEY=

# --- App config ---
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Appwrite staged pipeline ---
# Keep `legacy` until bootstrap + import + verification have all succeeded.
# Switch to `appwrite` to serve the applications board from Appwrite while
# continuing to dual-write changes back to Neon for rollback.
NEXT_PUBLIC_PIPELINE_BACKEND=legacy
# Switch after the resume/profile migration verifies exact counts.
NEXT_PUBLIC_WORKSPACE_BACKEND=legacy
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=job-os
NEXT_PUBLIC_APPWRITE_APPLICATIONS_TABLE_ID=application_cards
NEXT_PUBLIC_APPWRITE_RESUMES_TABLE_ID=resumes
NEXT_PUBLIC_APPWRITE_RESUME_VERSIONS_TABLE_ID=resume_versions
NEXT_PUBLIC_APPWRITE_RESUME_MESSAGES_TABLE_ID=resume_messages
NEXT_PUBLIC_APPWRITE_PROFILE_FACTS_TABLE_ID=profile_facts
NEXT_PUBLIC_APPWRITE_FACT_BULLETS_TABLE_ID=fact_bullets
NEXT_PUBLIC_APPWRITE_AGENT_JOBS_TABLE_ID=agent_jobs
NEXT_PUBLIC_APPWRITE_RESUME_FILES_BUCKET_ID=resume_files
NEXT_PUBLIC_APPWRITE_AGENT_FUNCTION_ID=job-os-agents
# Server only. Never expose this as a NEXT_PUBLIC_ variable.
APPWRITE_API_KEY=

# --- Environment ---
# Defaults to "production" in code, so omitting this is safe. Only the exact,
# lower-case string "development" selects dev behaviour.
#
# In development this also serves the interactive API docs at /docs, /redoc and
# /openapi.json. In production they are not mounted at all: the routes are
# correctly 401 either way, but publishing 48 paths and 63 models anonymously
# hands anyone probing a free map of the surface.
APP_ENV=development

# Mints a shared anonymous `dev-local` user when Clerk is not configured, so the
# app is usable locally without a Clerk instance. Requires APP_ENV=development
# as well -- both signals or no dev user. Without both, an API with no Clerk
# configuration returns 503 rather than serving everyone as one account.
#
# NEVER set this in a deployed environment. It is not a convenience flag there;
# it is an authentication bypass.
ALLOW_ANONYMOUS_DEV_USER=true

LOG_LEVEL=info
