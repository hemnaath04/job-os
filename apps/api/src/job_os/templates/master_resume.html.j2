{# Faithful recreation of the user's master resume layout.
   Renders a JSON Resume document to HTML. WeasyPrint converts to PDF.

   Conventions:
   - Dates are pre-formatted by the renderer (`fmt_date`, `fmt_range` filters).
   - Empty sections are simply skipped — no empty section dividers.
#}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{{ basics.name }} — Resume</title>
  <link rel="stylesheet" href="master_resume.css" />
</head>
<body>

<header class="masthead">
  <h1 class="name">{{ basics.name }}</h1>
  {% if basics.label %}
    <div class="label">{{ basics.label }}</div>
  {% endif %}
  <div class="contact">
    {% set bits = [] %}
    {% if basics.location and basics.location.city %}
      {% set _ = bits.append(basics.location.city + ', ' + (basics.location.region or '')) %}
    {% endif %}
    {% if basics.phone %}{% set _ = bits.append(basics.phone) %}{% endif %}
    {% if basics.email %}{% set _ = bits.append('<a href="mailto:' + basics.email + '">' + basics.email + '</a>') %}{% endif %}
    {{ bits | join(' · ') | safe }}
  </div>
  {% if basics.profiles %}
    <div class="contact">
      {% for p in basics.profiles %}
        {%- if p.url -%}
          <a href="{{ p.url }}">{{ p.url | replace('https://','') | replace('http://','') | replace('www.','') }}</a>
          {%- if not loop.last %} · {% endif -%}
        {%- endif -%}
      {% endfor %}
    </div>
  {% endif %}
</header>

{# ---------- EDUCATION ---------- #}
{% if education %}
<section>
  <h2>Education</h2>
  {% for ed in education %}
    <div class="entry">
      <div class="entry-row">
        <span class="primary">{{ ed.institution }}</span>
        {% if ed.location %}<span class="meta">{{ ed.location }}</span>{% endif %}
      </div>
      <div class="entry-row">
        <span class="secondary">
          {%- if ed.studyType %}{{ ed.studyType }}{% endif -%}
          {%- if ed.area %} in {{ ed.area }}{% endif -%}
        </span>
        <span class="meta">{{ fmt_range(ed.startDate, ed.endDate, ongoing_suffix='(expected)') }}</span>
      </div>
      {% if ed.courses %}
        <div class="coursework">
          <span class="label-inline">Related coursework:</span>
          {{ ed.courses | join(', ') }}
        </div>
      {% endif %}
    </div>
  {% endfor %}
</section>
{% endif %}

{# ---------- EXPERIENCE ---------- #}
{% if work %}
<section>
  <h2>Experience</h2>
  {% for w in work %}
    <div class="entry">
      <div class="entry-row">
        <span class="primary">{{ w.name }}</span>
        {% if w.location %}<span class="meta">{{ w.location }}</span>{% endif %}
      </div>
      <div class="entry-row">
        <span class="secondary">
          {%- if w.position %}<em>{{ w.position }}</em>{% endif -%}
          {%- if w.summary %} · {{ w.summary }}{% endif -%}
        </span>
        <span class="meta">{{ fmt_range(w.startDate, w.endDate) }}</span>
      </div>
      {% if w.highlights %}
        <ul class="bullets">
          {% for h in w.highlights %}<li>{{ h }}</li>{% endfor %}
        </ul>
      {% endif %}
    </div>
  {% endfor %}
</section>
{% endif %}

{# ---------- PROJECTS ---------- #}
{% if projects %}
<section>
  <h2>Projects</h2>
  {% for p in projects %}
    <div class="entry">
      <div class="entry-row">
        <span class="primary">{{ p.name }}</span>
        <span class="meta">{{ fmt_range(p.startDate, p.endDate, present_label='Present') }}</span>
      </div>
      {% if p.description or p.url %}
        <div class="secondary project-meta">
          {%- if p.description %}<em>{{ p.description }}</em>{% endif -%}
          {%- if p.url %}{% if p.description %} · {% endif %}<a href="{{ p.url }}">{{ p.url | replace('https://','') | replace('http://','') }}</a>{% endif -%}
        </div>
      {% endif %}
      {% if p.highlights %}
        <ul class="bullets">
          {% for h in p.highlights %}<li>{{ h }}</li>{% endfor %}
        </ul>
      {% endif %}
    </div>
  {% endfor %}
</section>
{% endif %}

{# ---------- TECHNICAL SKILLS (skills + certificates + interests grouped) ---------- #}
{% if skills or certificates or interests %}
<section>
  <h2>Technical Skills</h2>
  <dl class="skills-grid">
    {% for s in skills %}
      <dt>{{ s.name }}</dt>
      <dd>{{ s.keywords | join(', ') }}</dd>
    {% endfor %}
    {% if certificates %}
      <dt>Certifications</dt>
      <dd>
        {%- for c in certificates -%}
          {{ c.name }}{% if c.issuer %} ({{ c.issuer }}){% endif %}
          {%- if not loop.last %} · {% endif -%}
        {%- endfor -%}
      </dd>
    {% endif %}
    {% if interests %}
      <dt>Interests</dt>
      <dd>
        {%- for i in interests -%}
          {%- if i.keywords -%}{{ i.keywords | join('; ') }}{%- else -%}{{ i.name }}{%- endif -%}
          {%- if not loop.last %} · {% endif -%}
        {%- endfor -%}
      </dd>
    {% endif %}
  </dl>
</section>
{% endif %}

</body>
</html>
