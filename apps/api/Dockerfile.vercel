FROM python:3.12-slim-bookworm AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /uvx /usr/local/bin/

WORKDIR /app

COPY pyproject.toml uv.lock* ./
RUN uv sync --frozen --no-install-project --no-dev

COPY . ./
RUN uv sync --frozen --no-dev


FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH="/app/.venv/bin:$PATH"

# WeasyPrint needs these native libraries and fonts. Keeping the API as a
# container lets Vercel run the same PDF stack used by Render.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 \
        libpango-1.0-0 \
        libpangoft2-1.0-0 \
        libharfbuzz0b \
        libcairo2 \
        libgdk-pixbuf-2.0-0 \
        libffi8 \
        fonts-inter \
        fonts-noto-core \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app /app

# Vercel supplies PORT (80 by default). Migrations intentionally do not run
# here: autoscaling can start multiple instances concurrently. Run Alembic
# once as a release step before switching production traffic.
CMD ["sh", "-c", "exec /app/.venv/bin/uvicorn job_os.main:app --host 0.0.0.0 --port ${PORT:-80} --workers 1"]
