# Your Zyte API key. Required. Get one at https://www.zyte.com (Zyte API, then
# API access). Every request this function makes is billed to this account.
ZYTE_API_KEY=

# Comma-separated list of job listing pages to scrape. Required.
# You are responsible for the sites you put here: see the LEGAL note in the
# README before adding anything.
TARGET_URLS=https://example.com/careers,https://example.org/jobs

# How many of the returned jobs to open individually for company, location,
# posting date and description. Each one is a second Zyte call, so it costs
# more and takes longer. 0 disables hydration. Optional, default 0.
ZYTE_HYDRATE_LIMIT=0

# Optional shared secret. When set, the function returns 401 unless the request
# carries the header x-custom-source-key with this exact value. Configure the
# same header name and value in job.os under Custom sources.
SHARED_SECRET=
