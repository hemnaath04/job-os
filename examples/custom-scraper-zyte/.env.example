# Your Zyte API key. Required. Get one at https://www.zyte.com (Zyte API, then
# API access). Every request the spiders make is billed to this account.
ZYTE_API_KEY=

# Which spiders to run, comma separated. Optional.
# Available: linkedin, indeed, google, handshake
# Default when unset: linkedin,indeed,google
# handshake is deliberately not in the default: it does nothing unless you also
# supply your own session cookie below.
SPIDERS=linkedin,indeed,google

# Shared secret. Strongly recommended: without it, anyone who finds your
# deployment URL can spend your Zyte credit. When set, the function returns 401
# unless the request carries the header x-custom-source-key with this exact
# value. Configure the same header name and value in job.os under Custom
# sources.
SHARED_SECRET=

# --- Handshake only, both required to make that spider do anything ----------
# EXPERIMENTAL. Handshake has no public feed, so this uses your own logged-in
# session. The cookie expires within days and you will have to replace it. You
# are responsible for complying with your school's and Handshake's terms.
# Your Handshake host, for example app.joinhandshake.com
HANDSHAKE_HOST=
# The full Cookie header value copied from your browser's devtools while logged
# in to Handshake.
HANDSHAKE_SESSION_COOKIE=
